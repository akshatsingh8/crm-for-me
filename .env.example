NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Add every value below in Vercel Project Settings > Environment Variables.
# Use different long random values for the session secret and database access token.
CRM_LOGIN_ID=admin
CRM_LOGIN_PASSWORD=change-this-password
CRM_SESSION_SECRET=generate-a-long-random-value
CRM_DB_ACCESS_TOKEN=generate-a-second-long-random-value
